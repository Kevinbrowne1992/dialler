{
  "name": "zoiper-outbound-dialler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:singlefile": "vite build --config vite.singlefile.config.js && node -e \"const fs=require('fs'); fs.copyFileSync('dist-singlefile/index.html', 'dist-singlefile/ZoiperDialler.html'); console.log('✓ Successfully created dist-singlefile/ZoiperDialler.html');\"",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build:win": "vite build && cross-env TMPDIR=/Volumes/Untitled/Users/kevinbrowne1992/.cache/tmp ELECTRON_BUILDER_CACHE=/Volumes/Untitled/Users/kevinbrowne1992/.cache/electron-builder electron-builder --win",
    "electron:build:mac": "vite build && cross-env TMPDIR=/Volumes/Untitled/Users/kevinbrowne1992/.cache/tmp ELECTRON_BUILDER_CACHE=/Volumes/Untitled/Users/kevinbrowne1992/.cache/electron-builder electron-builder --mac",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.zoiper.dialler",
    "productName": "Zoiper Outbound Dialler",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

